# ==============================================================================
# PC & Desk Build Studio - Market API Credentials Configuration
# ==============================================================================
#
# To enable live official Amazon & Rakuten product photo & price sync:
# 1. Copy this file to '.env'
# 2. Fill in your official API credentials
# 3. Run: python scripts/update_market_parts.py
#

# --- Amazon Product Advertising API (PA-API v5) ---
# Obtain from: https://affiliate.amazon.co.jp/assoc_credentials/home
AMAZON_ACCESS_KEY=your_amazon_access_key_here
AMAZON_SECRET_KEY=your_amazon_secret_key_here
AMAZON_ASSOCIATE_TAG=your_tracking_id_here-22
AMAZON_REGION=fe.amazon-adsystem.com
AMAZON_HOST=webservices.amazon.co.jp

# --- Rakuten Developers API ---
# Obtain from: https://webservice.rakuten.co.jp/app/create
RAKUTEN_APPLICATION_ID=3e9e5694-ad63-45be-ab5a-d7644dc24363
RAKUTEN_ACCESS_KEY=pk_Scp1FbdRPfutvzXBG9fwJvF7bD0SHUHysSHD3PNKWl1
RAKUTEN_AFFILIATE_ID=57f37031.ba1da35d.57f37032.782d7851
